{
  "name": "@pulse/api",
  "version": "0.1.0",
  "description": "pulse-api — data layer for pNode Pulse. Hosts every API endpoint that the Next.js FE and external SDKs consume.",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "prisma:generate": "prisma generate --schema=../../prisma/schema.prisma",
    "postinstall": "prisma generate --schema=../../prisma/schema.prisma || true"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.2",
    "@prisma/client": "6.19.3",
    "@pulse/types": "file:../pulse-types",
    "bs58": "^6.0.0",
    "hono": "^4.6.14",
    "ioredis": "^5.8.2",
    "jose": "^6.1.3",
    "pino": "^9.5.0",
    "tweetnacl": "^1.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22",
    "prisma": "6.19.3",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^2.1.8"
  }
}
