{
  "name": "@pulse/api",
  "version": "0.1.0",
  "description": "pulse-api — Hono service hosting the tRPC server lifted from the Next.js monolith. Owns DB access; the Vercel-hosted FE talks to it.",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "build": "tsc; tsc-alias",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "prisma:generate": "prisma generate --schema=../../prisma/schema.prisma",
    "postinstall": "prisma generate --schema=../../prisma/schema.prisma"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.2",
    "@prisma/client": "6.19.3",
    "@pulse/types": "file:../pulse-types",
    "@trpc/server": "^11.0.0",
    "bs58": "^6.0.0",
    "bullmq": "^5.65.1",
    "hono": "^4.6.14",
    "ioredis": "^5.8.2",
    "jose": "^6.1.3",
    "nodemailer": "^7.0.11",
    "superjson": "^2.2.6",
    "tweetnacl": "^1.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/nodemailer": "^7.0.4",
    "prisma": "6.19.3",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^2.1.8"
  }
}
